{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectFile Pro",
  "version": "1.0.5",
  "identifier": "com.koo1j.projectfile-pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectFile Pro",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Professional file management and organization tool",
    "longDescription": "ProjectFile Pro is a powerful desktop application for managing, organizing, and processing files across your system. Features include AI-powered file assistance, duplicate detection, batch operations, and intelligent file mapping.",
    "copyright": "© 2026 ProjectFile Pro",
    "category": "DeveloperTool",
    "publisher": "ProjectFile Pro",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "infoPlist": "Info.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.ico",
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREM0U5QTQ5QUI5OUIwMDEKUldRQnNKbXJTWm8rVFpuQWtSTnBnUUxoQU1GbVprdzRNb0NRbS95U2dBMHF2VjQ4bjFRTVFiK3IK",
      "endpoints": [
        "https://github.com/jbridgepro/projectfile-pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}